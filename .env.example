# ============================================================
# GNotes 环境变量模板 —— 复制为 .env 并填入真实值
# ============================================================

# --- 安全密钥 ---
# JWT 签名密钥：≥32 字节随机字符串。生成命令：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 笔记内容 AES-256-GCM 主密钥：Base64 编码的 32 字节。生成命令：
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# 备份包加密密钥：Base64 编码的 32 字节，建议与上面独立（纵深防御）。
# 留空则回退到 ENCRYPTION_KEY（会打 warning）。
BACKUP_ENCRYPTION_KEY=

# --- 初始管理员（仅首次启动、users 表为空时创建）---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# --- 数据库 ---
DATABASE_PATH=/app/data/notes.db

# --- Google Drive 备份 ---
GOOGLE_DRIVE_CREDENTIALS_FILE=/app/secrets/gdrive.json
GOOGLE_DRIVE_FOLDER_ID=
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_COUNT=30

# --- 其他 ---
LOG_LEVEL=INFO
# 生产保持 false，不暴露 /docs /redoc /openapi.json
DEBUG=false
# 登录失败限流：同一 IP 在窗口内最多尝试次数
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# --- 前端（构建期变量）---
VITE_API_BASE_URL=/api/v1
